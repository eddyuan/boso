# Postgres (Neon or Supabase connection string)
DATABASE_URL=postgres://user:password@host:5432/tielo

# Better Auth
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL of this app (http://localhost:3000 in dev, your domain in prod)
BETTER_AUTH_URL=http://localhost:3000
# Other browser frontends allowed to call the API with cookies (CORS), comma-separated.
# http://localhost:8081 (Expo web) is allowed automatically in dev.
WEB_APP_ORIGINS=

# SMTP (verification codes). Unset in dev = codes are printed to the server log.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); leave unset to infer from port
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Tielo <no-reply@example.com>"

# Twilio SMS (phone sign-in codes). Unset in dev = codes are printed to the server log.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use a Messaging Service (recommended) or a single From number
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# Google sign-in (optional — enabled when ID + secret are set)
# Google Cloud console → APIs & Services → Credentials → OAuth client ID (type: Web application)
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only needed later for native Google sign-in (iOS / Android OAuth clients)
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Sign in with Apple (optional — enabled when all four are set)
# Apple Developer → Certificates, IDs & Profiles
APPLE_TEAM_ID=
# Services ID (e.g. com.tielo.app.signin), return URL: {BETTER_AUTH_URL}/api/auth/callback/apple
APPLE_SERVICES_ID=
# Keys → Sign in with Apple key: its Key ID and the .p8 contents (newlines as \n)
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# iOS bundle identifier (apps/mobile/app.json → ios.bundleIdentifier), for native sign-in
APPLE_APP_BUNDLE_ID=com.tielo.app

# AI for pet content (post text, comment replies). Format "<provider>:<model>".
# Providers: google, anthropic, openai. Default: google:gemini-3.8-flash
PET_AI_MODEL=google:gemini-3.8-flash
# Key for the chosen provider (only the one you use is needed)
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Inngest (durable background functions — https://app.inngest.com)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Object storage for uploads (profile photos). S3-compatible: Cloudflare R2, AWS S3, MinIO.
# Unset in dev = files are saved to apps/web/public/uploads.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL objects are served from (bucket public domain or CDN)
S3_PUBLIC_URL=

# Mapbox (public token, pk.*). Restrict it by URL in the Mapbox dashboard.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Places import (Google Places API, New). Used by scripts/import-places.mts --google
GOOGLE_PLACES_API_KEY=
