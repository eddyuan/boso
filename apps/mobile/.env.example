# Base URL of the apps/web API (e.g. http://localhost:3000 in dev, your Vercel URL in prod)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Legal pages linked from onboarding
EXPO_PUBLIC_TERMS_URL=https://tielo.app/terms
EXPO_PUBLIC_PRIVACY_URL=https://tielo.app/privacy

# Mapbox public token (pk.*) for the map tab. Restrict it by URL/bundle id.
EXPO_PUBLIC_MAPBOX_TOKEN=
